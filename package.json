{
  "name": "zeroplot",
  "version": "1.0.0",
  "description": "Paste CSV data and draw a line or scatter plot as SVG. No dependencies, plain HTML, CSS and JavaScript.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/launch.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "test:smoke": "node scripts/smoke.js",
    "check": "npm run lint && npm test && npm run test:smoke",
    "docs": "npm run docs:html && npm run docs:md",
    "docs:html": "jsdoc -c jsdoc.json",
    "docs:md": "node -e \"require('node:fs').mkdirSync('docs', { recursive: true })\" && jsdoc2md --no-cache -c jsdoc.json > docs/API.md"
  },
  "author": "Team 06",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "clean-jsdoc-theme": "5.2.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdoc": "^4.0.5",
    "jsdoc-to-markdown": "^9.1.3"
  },
  "overrides": {
    "@clean-jsdoc-theme/bhasha": "5.2.0",
    "@clean-jsdoc-theme/dwar": "5.2.0",
    "@clean-jsdoc-theme/rang": "5.2.0",
    "@clean-jsdoc-theme/setu": "5.2.0",
    "@clean-jsdoc-theme/utils": "5.2.0"
  }
}
