{
  "source": {
    "include": ["app_main", "libs", "server"],
    "includePattern": "\\.js$"
  },
  "sourceType": "module",
  "recurseDepth": 10,
  "opts": {
    "recurse": true,
    "destination": "docs/html",
    "readme": "readme.md",
    "template": "node_modules/clean-jsdoc-theme/dist",
    "siteName": "ZeroPlot API"
  },
  "plugins": ["plugins/markdown"]
}
